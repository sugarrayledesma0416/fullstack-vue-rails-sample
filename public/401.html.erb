<% content_for(:body_classes, 'ns-full-width') %>
<% content_for(:css_head, stylesheet_link_tag('music/features/error_page')) %>
<% content_for(:js_head, javascript_include_tag('error_page')) %>
<div class="c-error">
  <div class="c-error-image" role="img">
  </div>
  <h1 class="c-heading--xl  c-heading--xl--txt">UNAUTHORIZED</h1>
  <hr/>
  <h2 class="c-heading--page-title  c-heading--page-title--txt  u-txt-ctr">
    The page you were trying to access is restricted. <br/>You may send the request again with appropriate authorization.
  </h2>
  <div class="c-button-group  c-button-group--lt  c-button-group--sm  flex-justify-ctr">
    <button class="c-button  c-button--border  c-button--width"><a href="/">Home</a></button>
  </div>
</div>
