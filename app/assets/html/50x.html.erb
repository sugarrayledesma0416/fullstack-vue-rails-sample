<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
  <head>
    <meta http-equiv="content-type" content="text/html;charset=UTF-8" />
    <title>We're sorry, but something went wrong (500)</title>
    <%= stylesheet_link_tag('full_width_content') %>
    <%= stylesheet_link_tag('resetbase') %>
    <%= stylesheet_link_tag('application') %>
    <%= stylesheet_link_tag('layout') %>
    <%= stylesheet_link_tag('full_width_content') %>
    <%= stylesheet_link_tag('print') %>
    <%= javascript_include_tag('rollbar') %>
  </head>
  <body class="standard_layout error_page index">
    <div id="page_container">
      <div id="masthead" class="off">
        <a id="vista_logo" href="/ua_home"><img alt="Vista Higher Learning" src="/images/vista_logo.png?1275659938" /></a>
        <ul id="account_menu">
          <li><a href="/ua_home">Home</a></li>
          <li><a href="http://support.vhlcentral.com/" target="_blank">Help</a></li>
        </ul>
      </div>
      <!-- end masthead -->
      <div id="column_wrapper">
        <div id="main_content">
          <div id="full_width_header">
            <h2>server <span>error</span></h2>
          </div>
          <div id="full_width_body">
            <p>We're sorry, but something went wrong.</p>
            <p>We've been notified about this issue and we'll take a look at it shortly.</p>
            <p><a href="/ua_home">Home</a></p>
          </div> <!-- end #full_width_body -->
        </div><!-- end #main_content -->
      </div> <!-- end #column_wrapper -->
      <div id="footer">
        <p>
          For Technical Support: Click <a href="http://support.vhlcentral.com">support.vhlcentral.com</a>,
          or E-mail <a href="mailto:techsupport@vistahigherlearning.com">techsupport@vistahigherlearning.com</a>&nbsp;
        </p>
        <p class="copyright">
          &copy; <span id="copy_year">2013</span>
          <a href="http://vistahigherlearning.com/">VISTA Higher Learning, Inc.</a> |
          <a href="http://vistahigherlearning.com/students/store/">Store</a>
        </p>
      </div>
      <!-- end footer -->
    </div>
    <script>
      Rollbar.error('Nginx server error', { referrer: document.referrer, cookies: document.cookie });
    </script>
  </body>
</html>

