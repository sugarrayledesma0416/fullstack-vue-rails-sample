<div class="l-center-block  l-center-block--32">
  <div class="c-box  c-box--lozenge  u-pad-0  u-oflow-hid">
    <div class="c-table-wrapper  c-table-wrapper--toc-jr">
      <table class="c-table  c-table--toc-jr  js-table--activities">
        <thead>
          <tr class="c-header-row  c-header-row--toc-jr">
            <th role="columnheader" scope="col" class="c-header-cell  c-header-cell--toc-jr  c-col-component">
              <h3
                lang="<%= component_language %>"
                class="c-table--toc-jr__subtitle  toc_location_component">
                <%= component_name.html_safe %>
              </h3>
            </th>
            <th role="columnheader" scope="col" class="c-header-cell  c-header-cell--toc-jr  c-col-status  status">Status</th>
            <th role="columnheader" scope="col" class="c-header-cell  c-header-cell--toc-jr  c-col-due-date  u-txt-rt">Due date</th>
          </tr>
        </thead>
        <tbody>
          <%= render(
                '/partials/nothing_assigned_in_component',
                presenter: presenter,
                activities: component_activities
              ) %>
          <% component_activities.each do |activity| -%>
            <% due_date_handler = presenter.due_date_info_for(activity.id) %>
            <tr class="c-row  c-row--toc-jr  js-row--activities
                        <% unless presenter.access_guardian.can_access_content?(activity, activity.lesson) -%>
                          unassignable_activity
                        <% end -%>
                        <% unless due_date_handler.activity_is_assigned? && due_date_handler.due_date_released? -%>
                          js-non-assigned-activity
                        <% end -%>
                        <%= test_class("activity-id-#{activity.id}") %>">
              <th scope="row"
                  role="rowheader"
                  class="c-cell  c-cell--toc-jr  c-col-activity  toc_location_activity_list_entry
                         u-pos-rel  js-toc-col-activity"
                  lang="<%= presenter.program_language %>">
                <%= render 'toc/activity_info', activity: activity, presenter: presenter %>
              </th>
              <td role="cell" 
                  class="c-cell  c-cell--toc-jr  c-col-status  completion_status  
                         <%= test_class('attempt-status') %>">
                <%= format_attempt_status(presenter: presenter, activity: activity) if presenter.attempt_status[activity.id].present? %>
              </td>
              <td role="cell" 
                  class="c-cell  c-cell--toc-jr  c-col-due-date  toc_location_activity_due_date
                         <%= test_class('activity-due-date') %>" 
                  id="due_date_cell_for_activity_id_<%= activity.id %>">
                <% if due_date_handler.activity_is_assigned? %>
                  <span class="c-due-label  c-due-label--toc-jr">Due </span>
                  <%= render(
                        'toc/due_date',
                        attempt_status: presenter.attempt_status,
                        due_date_handler: due_date_handler
                        ) %>
                <% end %>
              </td>
            </tr>
          <% end -%>
        </tbody>
      </table>
    </div>
  </div> <!-- /c-box--lozenge -->
</div>
