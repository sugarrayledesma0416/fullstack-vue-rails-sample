<div class="ns-music-v1">
  <h1>Instructor Resources Bulk Upload</h1>
  <div class="c-box c-box--outlined">
    <p>This tool allows you to mass upload instructor resources for the selected program.</p>
    <p>You should use a resources ZIP file and a CSV to orchestrate the creation. It is strongly recommended</p>
    <p>Avoid ZIP files larger than 2 GB.</p>
  </div>

  <div class="c-form-item-group">
    <%= form_tag(select_program_bulk_resources_uploader_path, method: :get ) do %>
      <div class="c-form-item">
        <%= select_tag 'program_id', options_from_collection_for_select(@programs, 'id', 'title'), :include_blank => 'Select Program', class: 'c-select u-mar-bot-16', id: 'program_id' %>
      </div>
      <div class="c-form-item">
        <%= submit_tag 'Bulk upload', class: 'c-button  c-button--primary  u-mar-bot-16', id: 'export_button', disabled: true %>
      </div>
    <% end %>
  </div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const selectElement = document.getElementById('program_id');
    const submitButton = document.getElementById('export_button');

    selectElement.addEventListener('change', function () {
      submitButton.disabled = !selectElement.value;
    });
  });
</script>
