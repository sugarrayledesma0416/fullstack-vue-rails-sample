<html>
  <head>
    <script type="text/javascript">
      /**
       * This method adds page number dynamically on pdf footer generated by wicked_pdf gem.
       * This approach is referred from wicked_pdf's github page.
       */
      function addPageNumbering() {
        var obj = {};
        var searches = document.location.search.substring(1).split('&');
        for (var i in searches) {
          var z = searches[i].split('=', 2);
          obj[z[0]] = decodeURIComponent(z[1]);
        }
        var symbols = ['page', 'topage'];
        for (var i in symbols) {
          var y = document.getElementsByClassName(symbols[i]);
          for (var j = 0; j < y.length; ++j) {
            y[j].textContent = obj[symbols[i]];
          }
        }
      }
    </script>
    <style type="text/css">
      .portfolio-footer {
        margin: 0;
        padding: 0;
      }
      .hline {
        margin: 0;
        margin-bottom: 16px;
        padding: 0;
      }
      .pagination-text {
        padding: 0;
        text-align: right;
      }
    </style>
  </head>
  <body
    class="portfolio-footer"
    onload="addPageNumbering()">
    <hr class="hline">
    <div class="pagination-text">
      Page <span class="page"></span> of <span class="topage"></span>
    </div>
  </body>
</html>
