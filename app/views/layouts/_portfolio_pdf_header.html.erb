<html>
  <head>
    <style type="text/css">
      .portfolio-header {
        margin: 0;
        padding: 0;
      }
      .portfolio-header-logo {
        height: 60px;
        padding-bottom: 32px;
        padding-top: 8px;
        text-align: left;
        width: auto;
        /* This is to fix issue that some base64 svg logos
          are not getting left aligned otherwise. */
        <%= 'max-width: 180px;' if program_logo_svg?(current_program) %>
      }
    </style>
  </head>
  <body class="portfolio-header">
    <div class="portfolio-header-logo" >
    <%= format_portfolio_program_logo(current_program) %>
    </div>
  </body>
</html>
