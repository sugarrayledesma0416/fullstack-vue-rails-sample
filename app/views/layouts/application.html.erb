<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en" class="<%= yield :html_classes %>">
  <head>
    <%= render('partials/google_tag_manager') %>
    <%= render 'layouts/common_header' %>
  </head>

  <body
    <%= %(data-rendered-at="#{Time.now.to_f.to_s}") if Rails.env.test? %>
    class="notranslate <%= yield :body_classes %>  <%= yield :theme_classes %>"
    <%= yield :angular_tags %>>
    <% #query_review_output %>

    <div class="ns-masthead  ns-music-v1  <%= yield :theme_classes %>">
      <%= render 'app_shell/masthead',
                 section_header: @section_header,
                 course: @course,
                 section: @section,
                 flash: flash %>
    </div>

    <div id="page_container" class="c-page-container  js-page-container  ui-helper-clearfix  student_grades">
      <div id="column_wrapper" class="l-page  ui-helper-clearfix">
        <div class="container-fluid">
          <div class="l-page-title-block">
            <div class="l-page-title-before">
              <%= yield :before_page_title %>
            </div>
            <h1 class="c-heading--page-title page_title"><%= @page_title if @page_title -%></h1>
            <div class="l-page-title-after">
              <%= yield :after_page_title %>
            </div>
          </div>
        </div>

        <div class="container-fluid">
          <%= yield %>
        </div>

        <div class="ui-helper-clearfix"></div>
      </div><!-- end column_wrapper -->

      <% if (@presenter.nil? ||
            !@presenter.respond_to?(:lti_deep_link_enabled?) ||
            !@presenter.lti_deep_link_enabled?) &&
            !current_user.cartridge? %>
        <%= render 'partials/footer' %>
      <% end %>
      <%= render 'layouts/inactivity_timeout' %>
    </div>
  </body>
</html>
