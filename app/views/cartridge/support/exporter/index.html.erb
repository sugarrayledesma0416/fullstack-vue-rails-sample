<% content_for(:css_head, stylesheet_link_tag('cartridge/support/exporter')) %>

<div class='ns-music-v1'>
  <div class="c-logo">
    <h2><%= @program.title %></h2>
  </div>

  <%
    [
      ['1.1.0', MultiVersionCommonCartridge::CartridgeVersions::CC_1_1_0],
      ['1.2.0', MultiVersionCommonCartridge::CartridgeVersions::CC_1_2_0],
      ['1.3.0', MultiVersionCommonCartridge::CartridgeVersions::CC_1_3_0],
      ['Thin 1.2.0', MultiVersionCommonCartridge::CartridgeVersions::THIN_CC_1_2_0],
      ['Thin 1.3.0', MultiVersionCommonCartridge::CartridgeVersions::THIN_CC_1_3_0]
    ].each do |human_version, version|
  %>
  <div class="c-panel  u-bord-2  u-bord-gray-e" <%= test_attr('cc_version', version) %>>
    <div class="c-panel__header">
      <h3 class="c-heading--panel">Common cartridge <%= human_version %></h3>
    </div>
    <div class="c-panel__body">
      <%= form_with(
        url: cartridge_support_program_exporter_export_path(program_id: @program.id),
        method: :get
        ) do |form|
      %>
      <%= form.hidden_field(:cc_version, value: version) %>
      <%
        cartridges = @search.cartridges_by_version[version]
        if (cartridge = cartridges[:last_failed_cartridge]).present?
      %>
      <p class="<%= test_class('failed_cartridge') %>"><%= feature_icon('music/features/activity-shell/icons/icon-warning') %> Last cartridge created on <span class="u-txt-bold"><%= format_date_time(cartridge.created_at, :standard) %></span> by <span class="u-txt-bold"><%= cartridge.creator.full_name %></span> failed: <%= cartridge.error_message %>.</p>
        <% end %>
        <% if (cartridge = cartridges[:cartridge]).present? %>
      <p class="<%= test_class('valid_cartridge') %>"><%= link_to('Download', cartridge.signed_url, class: 'u-txt-upper') %> the latest valid cartridge, created on <span class="u-txt-bold"><%= format_date_time(cartridge.created_at, :standard) %></span> by <span class="u-txt-bold"><%= cartridge.creator.full_name %></span>.</p>
        <% else %>
      <p class="<%= test_class('no_valid_cartridge') %>">There is currently no valid cartridge to download.</p>
        <% end %>
      <p><%= submit_tag('Generate a new cartridge', class: 'c-button') %></p>
    <% end %>
    </div>
  </div>
  <% end %>
  <div>
    <%= link_to 'Back', cartridge_support_programs_path, class: 'c-button' %>
  </div>
</div>
