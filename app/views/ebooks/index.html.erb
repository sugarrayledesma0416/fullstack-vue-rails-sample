<% content_for(:body_classes, 'standard_layout') %>

<% content_for(:css_head, stylesheet_link_tag('full_width_content')) %>

<% if current_user.instructor? %>
  <% content_for(:focus, render(partial: 'instructor/focus/show')) %>
  <% content_for(:navigation, render(partial: 'app_shell/navbar_program/main')) %>
<% elsif current_user.student? -%>
  <% content_for(:navigation, render(partial: 'app_shell/navbar_section/main',
                                     locals: { section: current_section })) %>
<% end -%>

<div id="main_content">
  <div id="full_width_header">
    <h2>eBook</h2>
  </div>
  <div id="full_width_body">
    <%= render 'common_ebook_index' %>
  </div>
</div>
