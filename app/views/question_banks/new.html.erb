<div class="u-pad-bot-12">
  <%= link_to(question_bank_topic_path(id: @topic.id)) do %>
    <%= Music::Components.icon(
      variant: 'return',
      text: 'Return to Question Bank List',
      classes: ['c-embedded-icon--md', 'u-txt-16']
    ) %>
  <% end %>
</div>

<div>
  <div>New Question Bank for:</div>
  <div>Topic: <%= @topic.name %></div>
</div>

<%= render(
      'partials/form_errors',
      header_message: nil,
      object: @question_bank
    ) %>

<%= form_tag(
      question_bank_topic_question_banks_path(
        question_bank_topic_id: @topic.id
      ),
      method: :post,
      multipart: true
    ) do %>
  <%= render partial: 'upload_file_form' %>
  <%= submit_tag('Upload', class: 'c-button  c-button--primary') %>
<% end %>
