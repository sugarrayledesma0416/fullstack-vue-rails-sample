<%= content_for(:body_classes, 'ns-dashboard-announcements ns-music-v1') %>

<h1>Instructor Dashboard Announcements</h1>
<div class="c-button-group">
  <%= link_to 'Create announcement', new_dashboard_announcement_path, class: 'c-button c-button--border' %>
</div>
<% if @dashboard_announcements.present? %>
  <ul>
    <% @dashboard_announcements.each do |announcement| -%>
      <li class="<%= test_class("announcement-#{announcement.id}") %>" >
        <div class="c-box  c-box--outlined">
          <h3><%= announcement.title %></h3>
          <p><%= announcement.body %></p>
          <a href="<%= announcement.external_url%>"><%= announcement.link_text %></a>
          <div class="c-button-group">
            <button class="c-button">
              <%= link_to 'edit', edit_dashboard_announcement_path(announcement.id) %>
            </button>
            <button class="c-button  <%= test_class('delete-announcement') %>">
              <%= link_to('delete',
                          announcement,
                          data: { confirm: 'Are you sure you want to delete this announcement?' },
                          method: :delete) %>
            </button>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="u-txt-quiet  u-txt-ctr  u-txt-24  u-mar-top-64">
    <h2>There are no instructor dashboard announcements</h2>
  </div>
<% end %>
