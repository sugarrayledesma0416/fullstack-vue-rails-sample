<% content_for(:js_head, javascript_include_tag('support_tools/instructor_resources_export')) %>
<div class="ns-music-v1">
  <h1>Instructor Resources Export Tool</h1>
  <div class="c-box c-box--outlined">
    <p>This tool allows you to export instructor resources for the selected program.</p>
    <p>You can generate a .zip file containing all resources or download only the .csv file with the resource metadata.</p>
    <p>Note: The process for generating the .zip file may take a few minutes depending on the number of files to retrieve.</p>
  </div>
  <div class="c-form-item-group">
    <%= form_tag(export_instructor_resources_export_path, method: :get ) do %>
      <div class="c-form-item">
        <%= select_tag 'program_id', options_from_collection_for_select(@programs, 'id', 'title'), :include_blank => 'Select Program', class: 'c-select u-mar-bot-16', id: 'program_id' %>
      </div>
      <div class="c-form-item">
        <%= submit_tag 'Export Full Resources (ZIP)', class: 'c-button  c-button--primary  u-mar-bot-16', id: 'export_button', disabled: true %>
      </div>
    <% end %>
    <%= form_tag(export_csv_instructor_resources_export_path, method: :get ) do %>
      <div class="c-form-item">
        <%= hidden_field_tag :program_id, nil, id: 'csv_program_id' %>
        <%= submit_tag 'Download CSV Only', class: "c-button  c-button--primary  u-mar-bot-16  #{test_class('csv-button')}", id: 'csv_button', disabled: true %>
      </div>
    <% end %>
  </div>
</div>
