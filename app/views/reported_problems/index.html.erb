<% content_for(:body_classes, "standard_layout help_requests_page") %>
<% content_for(:css_head, stylesheet_link_tag("communication")) %>
<% status_closed = @presenter.status_scope == 'closed' %>
<% if current_user.instructor? %>
  <% content_for(:navigation, render(:partial => 'app_shell/navbar_program/main')) %>
<% elsif current_user.student? -%>
  <% unless current_section && current_section.non_zero? %>
    <% content_for(:body_classes, " no_section_student") %>
  <% end %>
  <% content_for(:navigation, render(:partial => 'app_shell/navbar_section/main', :locals => { :section => current_section })) %>
<% end -%>

<div id="main_content">
  <div class="ns-music-v1">
  <div class="u-mar-bot-16  u-mar-top-neg-12">
    <%= link_to @return_path,
                class: "u-mar-bot-16" do %>
      <%= Music::Components.icon(variant: 'return',text: '') %>
      Return to Dashboard
    <% end %>
  </div>
  <ol class="c-subnav  u-pad-lt-0  u-mar-bot-12  js-subnav  js-nav-system">
    <li><a class="c-subnav__link  <%= 'is-current' if !status_closed  %> " href=" <%= reported_problems_path(current_program, status: 'open') %> ">Open</a></li>
    <li><a class="c-subnav__link  <%= 'is-current' if status_closed  %>" href=" <%= reported_problems_path(current_program, status: 'closed') %> ">Closed</a></li>
  </ol>
 </div>
 <% if @presenter.help_requests_info.any? %>
   <%= render partial: 'help_requests/requests_table', locals: { presenter: @presenter } %>
 <% else %>
   <p>You don't have any open help requests for this course. Use the Help feature within an activity to report a technical or content issue.</p>
 <% end %>
</div>
