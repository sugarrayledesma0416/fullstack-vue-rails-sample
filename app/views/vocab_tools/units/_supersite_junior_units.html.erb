<% content_for(:js_head, javascript_packs_with_chunks_tag('jr/vocab_tools/units/index')) %>
<% content_for(:navigation) do %>
  <% render('app_shell/navbar_program/supersite_junior') %>
<% end %>
<% content_for(:body_classes, '  has-vhl-return-link') %>

<% namespace = 'ns-jr-lessons-index' %>

<% content_for(:left_of_page_title) do %>
  <div class="c-return-link-container">
    <vhl-return-link
      class="<%= test_class('return-link-root') %>"
      href="<%= jr_section_program_content_path(
                  program_id: current_program.id,
                  section_id: current_section.id ) %>"
      linktestclass="<%= test_class('return-link') %>">
      Return
    </vhl-return-link>
  </div>
<% end %>

<div id="main_content" class="<%= namespace %>">
  <ul class="c-plain-list  l-<%= namespace %>__lesson-list">
    <% current_program.units.each do |unit| %>
      <li class="c-<%= namespace %>__lesson-list-item  <%= test_class("unit-id-#{unit.id}") %>">
        <a class="c-ns-jr-lessons-index__lesson" href="/<%= current_program.id %>/sections/<%= current_section.id %>/vocab_tools/words?unit_id=<%= unit.id %>">
          <span class="c-<%= namespace %>__lesson-image-frame">
            <% if (media_item = unit.media_item) %>
              <%= image_tag(
                    media_item.public_filename,
                    alt: media_item.alt_text,
                    class: "c-#{namespace}__lesson-image"
                  ) %>
            <% else %>
              <%= image_tag(
                    'jr/icons/strand_default.svg',
                    'aria-hidden': true,
                    class: "c-#{namespace}__lesson-image"
                  ) %>
            <% end %>
          </span>
          <span class="c-<%= namespace %>__lesson-text  <%= test_class('unit-label') %>">
            <%= sanitize(unit.display_name, tags: %w[span], attributes: %w[lang]) %>
          </span>
        </a>
      </li>
    <% end %>
  </ul>
</div>
