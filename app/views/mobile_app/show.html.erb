<% content_for(:meta, '<meta name="apple-itunes-app" content="app-id=787520898"/>'.html_safe) %>
<% content_for(:meta, '<meta name="google-play-app" content="app-id=com.vistahigherlearning.practice_app"/>'.html_safe) %>
<% content_for(:css_head, stylesheet_link_tag('jquery.smartbanner') ) %>
<% content_for :js_head, javascript_include_tag('mobile_smartbanner') %>

<% content_for(:body_classes, "standard_layout app_page") %>
<% content_for( :css_head, stylesheet_link_tag("full_width_content") ) %>
<% content_for( :css_head, stylesheet_link_tag("mobile_app_page") ) %>
<% if current_user.instructor? %>
  <% content_for(:navigation, render(:partial => 'app_shell/navbar_program/main')) %>
<% else -%>
  <% content_for(:navigation, render(:partial => 'app_shell/navbar_section/main', :locals => { :section => current_section })) %>
<% end -%>

<div id="main_content">
  <div id="full_width_header">
    <h2>practice <span>partner</span></h2>
  </div>
  <%= render :partial => 'practice_partner_app' %>
</div>

