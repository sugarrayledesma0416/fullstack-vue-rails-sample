<l-stack-v3 gap="7" class="u-mar-24">
  <div class="u-hidden  js-possible-instructors" data-instructors="<%= {additional_instructors: @presenter.additional_instructor_options(@course)}.to_json %>"></div>
  <input type="hidden" class="js-section-id" id="section_id" name="section_id" value="">
  <input type="hidden" class="js-course-id" id="course_id" name="course_id" value="<%= @course.id %>">
  <form-item>
    <music-text-field-v3>
      <label for="section_name">Section Name</label>
      <input type="text" id="section_name" name="section_name" class="js-section-name-field" required/>
    </music-text-field-v3>
  </form-item>
  <music-text-field-v3>
    <label for="course_owner">Instructor (Course Owner)</label>
    <input type="text" id="course_owner" name="course_owner" value="course owner" class="js-section-owner-field" disabled/>
  </music-text-field-v3>
  <div class="c-form-item">
    <input class="c-form-item__checkbox  js-section-owner-visible-checkbox" type="checkbox" value="true" name="show_course_owner" id="show_course_owner"></input>
    <label class="c-form-item__label" for="show_course_owner">Visible to students in course</label>
  </div>
  <div class="u-mar-top-0  u-mar-bot-0 u-bord-bot-1 u-bord-true-gray-200"></div>
  <div class="js-additional-instructors-subform">
  </div>
  <div class="l-simple-grid-v3  l-simple-grid-v3--1-1">
    <button type="button"
          class="c-button-v3  c-button-v3--secondary-clear  c-button-v3--s  js-add-instructor">
    <music-icon-wrapper-v3 variant="outline" class="u-pad-4">
      <music-icon-plus-v3 size="6">
      </music-icon-plus-v3>
    </music-icon-wrapper-v3>
      Add additional instructor
    </button>
  </div>
  <div class="c-form-item">
    <input class="c-form-item__checkbox  js-section-open-checkbox" type="checkbox" value="true" name="section_open_to_students" id="section_open_to_students"></input>
    <label class="c-form-item__label" for="section_open_to_students">Allow new students to enroll in this course section</label>
  </div>
  <p>
    Select when assignments will be available before the due date. This will not apply to assessments.
  </p>
  <div class="l-simple-grid-v3  l-simple-grid-v3--2-1">
    <div class="c-form-item">
      <music-select-field-v3>
        <label class="u-screen-reader-only" for="days_to_show_assignment_due_date">Assignment Availability</label>
        <%= select_tag 'days_to_show_assignment_due_date',
            grouped_options_for_select(@presenter.days_to_show_assignment_due_date_options),
            class: 'js-section-days-to-show-assignment-due-date'%>
      </music-select-field-v3>
    </div>
  </div>
  <p>
    Assignments must be submited before:
  </p>
  <div class="l-simple-grid-v3  l-simple-grid-v3--2-1">
    <div class="l-simple-grid-v3  l-simple-grid-v3--1-1-1">
      <div class="c-form-item">
        <music-select-field-v3>
          <label for="due_date_hour">Hour</label>
          <%= select_tag 'due_date_hour', options_for_select((1..12).map(&:to_s)), include_blank: true, class: 'js-section-due-date-hour' %>
        </music-select-field-v3>
      </div>
      <div class="c-form-item">
        <music-select-field-v3>
          <label for="due_date_min">Minute</label>
          <%= select_tag 'due_date_min', options_for_select(%w[00 15 30 45 59]), include_blank: true, class: 'js-section-due-date-min' %>
        </music-select-field-v3>
      </div>
      <div class="c-form-item">
        <music-select-field-v3>
          <label for="due_date_ampm">AM/PM</label>
          <%= select_tag 'due_date_ampm', options_for_select(%w[AM PM]), include_blank: true, class: 'js-section-due-date-ampm' %>
        </music-select-field-v3>
      </div>
    </div>
  </div>
  <div class="c-form-item">
    <music-select-field-v3>
      <label for="time_zone">Time Zone</label>
      <%= select_tag 'time_zone',
          options_for_select(
            @presenter.timezone_options_for_select
          ),
          required: true,
          include_blank: true,
          class: 'music-select  js-section-time-zone'%>
    </music-select-field-v3>
  </div>
</l-stack-v3>
