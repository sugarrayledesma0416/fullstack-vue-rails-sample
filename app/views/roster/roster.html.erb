<%# Let the UI take up the full viewport: %>
<% content_for(:body_classes, '  ns-full-width') %>
<%= vite_javascript_tag 'entrypoints/roster/roster' %>
<%# Shared subnav lives in m3 so roster can use it: %>
<%# TODO: This will remove by Program navigation epic %>
<div class="c-gradebook-subnav-wrapper">
  <%= render 'partials/gradebook_shared_subnav', active_subnav: 'roster' %>
</div>
<% if @presenter.student_data.empty? %>
  <l-stack-v3 align-x="center" align-y="center" gap="2" class="c-roster-empty-wrapper">
    <h1 class="c-heading-v3--2  u-txt-true-gray-900">No Students Enrolled</h1>
    <p  class="u-txt-true-gray-700">Students will appear here once they are enrolled.</p>
    <% unless current_user.rostering? %>
      <sl-button
        <% unless @show_section_selector %>
          href="<%= new_instructor_enrollment_path(current_program.id, return_to: request.fullpath) %>"
        <% else %>
          type="button"
        <% end %>
        class="sl-button-v3  sl-button-v3--primary u-mar-top-16  js-add-students">
        <sl-icon
          slot="prefix"
          class="u-txt-util-white" 
          name="plus"
          library="untitled-ui"></sl-icon>
        Add Students
      </sl-button>
    <% end %>
  </l-stack-v3>
<% else %>
  <l-stack-v3 class="u-pad-rt-24  u-pad-lt-24  u-mar-top-neg-16">
    <m3-subnavigation-header page-title="<%= @page_title %>" description="<%= @presenter.students_count_label %> ">
      <% if current_section.section_instructors.exists?(role: SectionInstructor::RESPONSIBLE_ROLES.values, user_id: current_user.id) %>
        <div class="c-interaction-settings-btn" data-page-element="student_interaction_settings_link">
          <sl-button 
            href="<%= section_student_settings_show_path(
              program_id: current_program.id,
              section_id: current_section.id
            )%>"
            id="<%= appcues_id('student_interaction_settings') %>"
            class="sl-button-v3  sl-button-v3--secondary-clear  js-intraction-settings  js-intraction-settings-btn"
            rel="">
            <sl-icon
              slot="prefix"
              name="settings"
              library="untitled-ui"></sl-icon>
            Interaction Settings
          </sl-button>
        </div>
      <% end %>
        <% unless current_user.rostering? %>
          <sl-button
            <% unless @show_section_selector %>
              href="<%= new_instructor_enrollment_path(current_program.id, return_to: request.fullpath) %>"
            <% else %>
              type="button"
            <% end %>
            class="sl-button-v3  sl-button-v3--secondary js-add-students">
            <sl-icon
              slot="prefix"
              class="u-txt-util-white" 
              name="plus"
              library="untitled-ui"></sl-icon>
            Add
          </sl-button>
        <% end %>
      <m3-more-options-menu>
        <sl-menu>
          <% if current_section.section_instructors.exists?(role: SectionInstructor::RESPONSIBLE_ROLES.values, user_id: current_user.id) %>
            <sl-menu-item class="c-interaction-settings-item" >
              <div data-page-element="student_interaction_settings_link">
                <a
                  href="<%= section_student_settings_show_path(
                    program_id: current_program.id,
                    section_id: current_section.id
                  )%>"
                  id="<%= appcues_id('student_interaction_settings') %>"
                  class="u-txt-true-gray-900  u-txt-nodec">
                  Interaction Settings
                </a>
              </div>
            </sl-menu-item>
          <% end %>
          <% unless current_user.clever? %>
            <sl-menu-item data-page-element="email_link">
              <%= link_to('Email Students',
                    gradebook_email_students_path(program_id: current_program, return_to: request.fullpath),
                    class: 'js-email-students-open-feature  u-txt-true-gray-900  u-txt-nodec') %>
            </sl-menu-item>
          <% end %>
          <% if @grace_periods.allowed? && !current_user.clever? %>
            <sl-menu-item>
              <%= link_to('Manage Grace Periods',
                    instructor_grant_student_grace_period_path(current_program,
                                                          current_focus.course,
                                                          return_to: request.fullpath),
                    class: 'u-txt-true-gray-900  u-txt-nodec') %>
            </sl-menu-item>
          <% end %>
          <% unless current_user.rostering? %>
          <sl-menu-item>
            <%= link_to('Remove Students',
                  gradebook_drop_students_edit_path(program_id: current_program.id, return_to: request.fullpath),
                  class: 'u-txt-true-gray-900  u-txt-nodec  js-drop-students') %>
          </sl-menu-item>
          <% end %>
        </sl-menu>
      </m3-more-options-menu>
    </m3-subnavigation-header>
    <div class="c-table-roster-wrapper">
      <table class="c-table-v3  c-table-roster">
        <thead>
          <tr>
            <th class="c-table-v3__th">Name</th>
            <% unless current_user.clever? %>
              <th class="c-table-v3__th" >Email Address</th>
            <% end %>
              <th class="c-table-v3__th">Last Submission</th>
          </tr>
        </thead>
        <tbody>
            <% @presenter.student_data.each do |student| %>
              <tr>
                <td class="c-table-v3__td">
                  <l-line-v3 align-y="center">
                  <% unless student[:sufficient_access] %>
                    <sl-tooltip content="<%= student[:insufficient_access_message] %>">
                      <sl-icon
                        class="u-txt-util-error  u-txt-20" 
                        name="alert-circle"
                        library="untitled-ui"></sl-icon>
                    </sl-tooltip>
                  <% end %>
                  <%= student[:name] %></td>
                <% unless current_user.clever? %>
                  <td class="c-table-v3__td  c-table-roster__email" >
                    <%= link_to(student[:email],
                            gradebook_email_students_path(program_id: current_program, return_to: request.fullpath)) %>
                  </td>
                <% end %>
                <td class="c-table-v3__td c-table-v3__last-submission" >
                  <% if student[:last_submission][:date] != nil && student[:last_submission][:time] != nil %>
                    <p class="u-mar-bot-0"><%= student[:last_submission][:date] %></p>
                    <p class="u-mar-bot-0  u-txt-detail  u-txt-true-gray-400"><%= student[:last_submission][:time] %></p>
                  <% else %>
                    -
                  <% end %>
                </td>
              </tr>
            <% end %>
        </tbody>
      </table>
    </div>
  </l-stack-v3>
<% end %>

<% if @show_section_selector %>
  <%= render 'roster/section_selector_dialog'%> 
<% end %>
