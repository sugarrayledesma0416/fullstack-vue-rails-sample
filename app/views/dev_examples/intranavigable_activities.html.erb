          <img class="c-intranav-activity-image" src="<%= image_url('maestro_activity_engine/features/vocabulary_tutorial/illustrations/match.svg')%>" alt=""/>
          <h4>Junior</h4>
          <img class="c-intranav-activity-image" src="<%= image_url('maestro_activity_engine/features/vocabulary_tutorial/illustrations/jr-match.svg')%>" alt=""/>
        </div>
        <div class="c-intranav-activity-action">
          <h3 class="u-txt-gray-6">Say it</h3>
          <h4>Senior</h4>
          <img class="c-intranav-activity-image" src="<%= image_url('maestro_activity_engine/features/vocabulary_tutorial/illustrations/say-it.svg')%>" alt=""/>
          <h4>Junior</h4>
