          <h4>Junior</h4>
          <div class="c-intranav-activity-animation" id="pompom"></div>
          <script type="text/javascript">
          document.addEventListener('DOMContentLoaded', () => {
            let event = new Event('StartPomPomAnimation');
            window.dispatchEvent(event);
          });
          </script>
        </div>
      </div>
    </li>
