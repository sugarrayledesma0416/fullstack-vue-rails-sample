          <img class="c-intranav-activity-image" src="<%= image_url('maestro_activity_engine/features/interactive_video/ssjr-intro-interactive-video.svg')%>" alt=""/>
        </div>
        <div class="c-intranav-activity-action">
          <h3 class="u-txt-gray-6">Diagnostic</h3>
