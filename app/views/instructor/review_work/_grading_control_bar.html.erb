
<div id="grading_control_bar" class="ui-helper-clearfix">

  <div id="instructor_editing_tools">

    <!-- grading bar, top row: -->
    <div class="grid--inner  ns-music-v1">

      <div class="col-10  u-mar-bot-16">

        <%= link_to(section_activity_path(0, activity_id) + "/?popup=1",
            :class => "c-button  c-button--sm  c-button--instructor-tool",
            :id => "preview_link_#{activity_id}",
            :role => "button",
            :onclick => format_popup_onclick({ :window_name => "preview_#{activity_id}",
                                               :width => 985, :height => 600 }),
            :target => '_blank') do %>
          <%= Music::Components.icon(variant: 'reference' , text: 'View Activity') %>
        <% end %>
      </div>

      <div class="col-2">
        <% if presenter.show_instructor_display_controls? %>
        <div id="instructor_display_controls">
          <%= check_box_tag('show_hide_comments', 'yes', presenter.show_comments,
              {class: 'inline', 'data-dash-change' => 'toggle_comments'}) %>
          <label for="show_hide_comments">Comment boxes</label><br>
          <%= check_box_tag('show_hide_student_names', 'yes', presenter.show_student_names,
              {class: 'inline', 'data-dash-change' => 'toggle_names' }) %>
          <label for="show_hide_student_names">Student names</label>
        </div>
        <% end %>
      </div> <!-- /col-2 (right col) -->
    </div> <!-- / grid (top row) -->

    <!-- grading bar, bottom row: -->
    <div class="grid--inner">
      <div class="col-3">
        <!-- Live Person Image -->
        <div id='LP_DIV_1383750138523' style='width:200px; height:20px; float:right; margin-top:5px;'></div>
        <!-- / Live Person Image -->
      </div> <!-- / col-3 (right col) -->
    </div> <!-- / grid (bottom row) -->

  </div> <!-- /#instructor_editing_tools -->
</div> <!-- /#grading_control_bar -->
