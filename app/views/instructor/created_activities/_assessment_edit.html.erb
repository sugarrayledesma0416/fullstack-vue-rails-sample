<%
  # A number of the meta tags set in activities/include expect @activity
  # to be assigned, and the virtual chat/video virtual chat code relies on
  # those meta tags being present. @activity isn't assigned in the controller
  # actions that render this view. In instructor/created_activities#edit
  # and #update, # the @created_activity variable is assigned. In
  # instructor/assessments#new and #create, @assessment is assigned.
  @activity = @created_activity || @assessment
%>
<%= render 'activities/include' %>

<%
  content_for(:js_head, javascript_include_tag('maestro_activity_engine/instructor_note_audio_player'))
  content_for(:js_head, javascript_include_tag("maestro_activity_engine/instructor_note_audio_recorder"))
  content_for(:css_head, stylesheet_link_tag('maestro_activity_engine/recording'))
  content_for(:css_head, stylesheet_link_tag('custom_assessments/main_temp.css'))
  content_for(:css_head, stylesheet_link_tag('custom_assessments/icons.css'))

  # needed to support display of virtual chat / video virtual chat
  content_for(:css_head, stylesheet_link_tag('maestro_activity_engine/virtual_chat'))
  content_for(:css_head, stylesheet_link_tag('maestro_activity_engine/chat_activity'))
  content_for(:js_head, javascript_include_tag('maestro_activity_engine/bindable'))
  unless @virtual_chat_bootstrapped
    content_for(
      :js_head,
      javascript_include_tag('maestro_activity_engine/virtual_chat/bootstrap')
    )
    @virtual_chat_bootstrapped = true
  end
  unless @video_virtual_chat_bootstrapped
    content_for(
      :js_head,
      javascript_include_tag('maestro_activity_engine/video_virtual_chat/bootstrap')
    )
    @video_virtual_chat_bootstrapped = true
  end
  content_for(:body_classes, ' vchat-video')

  content_for(:body_classes, '  ns-music-v1  ns-full-width')
  content_for(:js_head, javascript_packs_with_chunks_tag('instructor/created_activities/assessment_edit'))
  content_for(:css_head, stylesheet_packs_with_chunks_tag('instructor/created_activities/assessment_edit'))
%>

<% unless defined? @video_player_js_loaded %>
  <% content_for(:js_head, javascript_include_tag("maestro_activity_engine/video_player") ) %>
  <% @video_player_js_loaded = true %>
<% end %>

<% content_for(:css_head, stylesheet_link_tag('instructor/created_activities/assessment_edit')) %>

<input id="recording_server_host" type="hidden" value="<%= recording_configuration_instance.server_host %>">
<% recording = Recording.new %>
<input id="recording_file_prefix" type="hidden" value="<%= recording.generate_file_prefix %>">

<input id="activity_type" type="hidden" value="video" />

