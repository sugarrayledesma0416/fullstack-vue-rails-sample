<div id="activity_wrapper" class="c-activity-wrapper  u-bg-gray-f5">
  <div id="main_content">
    <div class="l-container-fluid">

      <div class="l-grid  u-mar-top-24  u-mar-bot-24">
        <div class="l-col-12  u-bg-gray-f5  u-mar-top_24  u-pad-top-16  u-pad-bot-0  js-sticky-menu-bar-top">
          <div class="ns-stick-menu">
            <div class="u-dis-flex  flex-justify-ctr  js-sticky"></div>
          </div>
        </div>
      </div>
      <div
        class="js-custom-assessments-app"
        data-activity-id="<%= created_activity.id %>"
        data-allows-audio-transcripts="<%= current_program.has_audio_transcripts? %>"
        data-course-allows-audio-transcripts="<%= current_focus.course&.allow_audio_transcripts? %>"
        data-content-json="<%= created_activity.content_json %>"
        data-default-title="<%= "#{created_activity.lesson_name} | #{created_activity.concept_name}" %>"
        data-direction-line="<%= created_activity.direction_line %>"
        data-draft="<%= created_activity.draft %>"
        data-allows-question-banks="<%= current_program.question_banks_enabled? %>"
        data-lesson-id="<%= created_activity.lesson_id %>"
        data-lesson-name="<%= created_activity.lesson.name %>"
        data-media-item-recording-endpoint="<%= Rails.application.config.multimedia.instructor_media_items.recording_endpoint %>"
        data-media-lookup="<%= created_activity.media_lookup.to_json %>"
        data-program-language="<%= {
          code: current_program.language_code,
          name: current_program.language_name
        }.to_json %>"
        data-recording-cdn-prefix="<%= Rails.application.config.multimedia.recording_v2.cdn_prefix %>"
        data-recording-endpoint="<%= Rails.application.config.multimedia.recording_v2.recording_endpoint %>"
        data-return-url="<%= instructor_assessments_path(current_program) %>"
        data-start-unit="<%= created_activity.lesson.unit.rank %>"
        data-strand-id="<%= created_activity.toc_location %>"
        data-strand-name="<%= created_activity.strand.title %>"
        data-student-title="<%= (
                                  created_activity.student_title.presence ||
                                  "#{created_activity.lesson_name} | #{created_activity.concept_name}"
                                ) %>"
        data-submit-url="<%= form_url %>"
        data-title="<%= created_activity.title %>"
        data-config-name="m3_assessment_builder"
        ></div>

    </div> <!-- l-container-fluid -->
  </div> <!-- main_content -->
</div> <!-- activity_wrapper -->

<% if accent_bar_enabled? %>
  <div class="u-mar-0  js-accent-bar-container--activity">
    <%= render(
          'music/partials/accent_bar_component',
          language: current_program.language_code
        ) %>
  </div>
  <%= render 'instructor/created_activities/accent_bar_chars', current_program: current_program %>
<% end %>
