<% class_prefix = (student == original_user) ? 'user' : 'partner' %>
<% id_prefix = "partner_#{student.id}_#{class_prefix}" %>

<% # It's strange to ask a student if they are an instructor, but an
   # instructor *can* do a partner chat with a student.
%>
<% if student.instructor? %>
<div class="<%= class_prefix %>_container">
  <div id="<%= id_prefix %>" class="<%= partner_chat_class(student, original_user) %> not_gradeable">
    <div class="<%= class_prefix %>_name"><%= student.full_name %></div>
    <div id="<%= id_prefix %>_grading" class="ui-helper-clearfix">
      <div class="cannot_grade_explanation">Instructors cannot be graded.</div>
    </div>
  </div>
</div>

<% elsif presenter.gradeable?(student) %>
<div class="<%= class_prefix %>_container">
  <div class="<%= partner_chat_class(student, original_user) %>">
    <div class="<%= class_prefix %>_name"><%= student.full_name %></div>
    <% if presenter.partner_is_practicing?(student, original_user) %>
      <%= hidden_field_tag "practice_mode[#{student.id}]", true %>
      <span class="practicing">
        This student completed <br />
        activity as 'practice', <br />
        and therefore cannot <br />
        be graded.
      </span>
    <% else %>
      <div class="user_grading  u-width-full">
        <%= render(
              'instructor/grading_sets/score_controls',
              view_manager: ScoreControlsViewManager.new(
                question,
                feedback,
                results,
                presenter.response_id(student, question),
                params
              ),
              user_id: student.id
            )
        %>
      </div>

      <div class="user_comments <%= class_prefix %>_comments">
        <%= render  :partial => 'instructor/grading_sets/all_instructor_comments',
                    :locals => {:question => question,
                                :response_id => presenter.response_id(student, question),
                                :feedback_item => feedback,
                                :recording_path => recording_path,
                                :is_new_recording => presenter.new_recording?(student, question) } %>
      </div>
    <% end %>
  </div>
</div>

<% else %>
<div class="<%= class_prefix %>_container">
  <div id="<%= id_prefix %>" class="<%= partner_chat_class(student, original_user) %> not_gradeable">
    <div class="<%= class_prefix %>_name"><%= student.full_name %></div>
    <div id="<%= id_prefix %>_grading">
      <div class="cannot_grade_explanation">You cannot grade this student because they are not in your section.</div>
    </div>
  </div>
</div>
<% end %>
