<% content_for( :css_head, stylesheet_link_tag('music/features/assignment_calendar/instructor/main')) %>
<% content_for(:body_classes, "standard_layout calendar") %>

<% content_for( :js_head, javascript_include_tag("jquery.vhl-checkboxes.js") ) %>
<% content_for(:js_head, javascript_include_tag('add_assignments')) %>
<% content_for(:js_head, javascript_include_tag('coming_soon')) %>
<% content_for(:css_head, stylesheet_link_tag("add_assignments_dialog")) %>

<%= render :partial => 'partials/coming_soon' %>

<% unless @in_institution_admin %>
  <% content_for(:focus, render(:partial => 'instructor/focus/show')) %>
  <% content_for(:navigation, render(:partial => 'app_shell/navbar_program/main')) %>
<% end %>

<% if current_focus.has_atleast_one_actionable_section? %>
    <div id="instructor_assignment_calendar">
      <div id="instructor_assign_link" class="ui-helper-clearfix  ns-music-v1  test-instructor-assignments-start-assigning">
        <% if assistant_role_policy.is_assistant? -%>
          <%= Music::Components.button(text: 'Start Assigning', state: 'disabled', variant: 'primary') %>
        <% else -%>
          <% new_assignments_route = (@in_institution_admin ?
                                     institution_admin_new_assignment_template_path(program_id: current_program.id) :
                                     instructor_new_assignments_path(program_id: current_program.id)) %>
          <%= link_to 'start assigning',
                      new_assignments_route,
                      { class: 'assign_link  c-button  c-button--primary' } %>
        <% end -%>
      </div>
      <div data-container-type="event_calendar" id="event_calendar_container">
        <%= render partial: 'instructor/calendar/event_calendar',
                   locals: { calendar_presenter: @calendar_presenter } %>
      </div>
    </div>
    <div id ="calendar_modal_box"></div>
<% else %>
  <div id="main_content">
    <%= render :partial => 'instructor/partials/no_actionable_course_or_section' %>
  </div>
<% end %>
