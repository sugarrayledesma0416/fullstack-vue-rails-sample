<% content_for( :css_head, stylesheet_link_tag('music/features/assignment_calendar/instructor/main')) %>
<% content_for( :css_head, stylesheet_link_tag('music/features/assignment_calendar/instructor/calendar_theme_overrides')) %>
<% content_for(:body_classes, "standard_layout assignment_page") %>

<% content_for( :js_head, javascript_include_tag("jquery.hoverIntent.minified.js") ) %>
<% content_for( :js_head, javascript_include_tag("jquery.vhl-checkboxes.js") ) %>

<% content_for(:css_head, stylesheet_link_tag("add_assignments_dialog")) %>

<% unless @in_institution_admin %>
  <% content_for(:focus, render(partial: 'instructor/focus/show')) %>
  <% content_for(:navigation, render(partial: 'app_shell/navbar_program/main')) %>
<% end %>

<% if current_focus.has_atleast_one_actionable_section? %>

  <div id="assignment_wrapper" class="ui-helper-clearfix">
    <div id="instructor_unassigned_activities">
        <%= render :partial => 'instructor/assignment_filters/edit', :locals => {
        :presenter => @assignment_filter_presenter
        } %>
    </div>

    <div id="unassigned_activities" class="wrap">
      <%= render :partial => 'instructor/assignments/unassigned_activities', :locals => { :presenter => @assignment_filter_presenter} %>
    </div>

    <div id="instructor_assignment_calendar">
      <%= render partial: 'instructor/calendar/event_calendar',
                 locals: { calendar_presenter: @calendar_presenter } %>
    </div>
    <div id ="calendar_modal_box"></div>
  </div>

<% else %>
  <div id="main_content">
    <%= render :partial => 'instructor/partials/no_actionable_course_or_section' %>
  </div>
<% end %>
