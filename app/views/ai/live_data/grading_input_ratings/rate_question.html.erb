<%= content_for(
      :js_head,
      javascript_packs_with_chunks_tag('ai/live_data/grading_input_ratings/rate_question')
    ) %>

<%= content_for(
      :css_head,
      stylesheet_packs_with_chunks_tag('ai/live_data/grading_input_ratings/rate_question')
    ) %>

<div class="c-box  c-box--bubble-wrap">
  <span class="u-txt-bold">Location:</span>
  <a href="<%= @presenter.lesson_url %>"><%= @presenter.activity.lesson.name %></a>
  &rarr;
  <a href="<%= @presenter.strand_url %>"><%= @presenter.activity.lesson_strand_label %></a>
  &rarr;
  <%= ActivityLinkPresenter.new(self).instructor_toc_link(@presenter.activity, @presenter, true) %>
  <br>
  <span class="u-txt-bold">Direction Line:</span> <%= @presenter.activity.direction_line.html_safe %>
  <br>
  <span class="u-txt-bold">Question prompt:</span><%= @presenter.question.html_friendly_prompt %>
</div>

<div
  class="js-ai-live-data-grading-input-ratings-rate-question-app"
  data-grading-suggestion-inputs="<%= @presenter.serialized_grading_suggestion_inputs.to_json %>"
  data-rate-overall-comment-url="<%= @presenter.rate_overall_comment_url %>"
  data-accept-overall-comment-rating-category-id="<%= @presenter.accept_overall_comment_rating_category.id %>"
  data-reject-overall-comment-rating-category-id="<%= @presenter.reject_overall_comment_rating_category.id %>"
  data-rate-grading-suggestion-url="<%= @presenter.rate_grading_suggestion_url %>"
  data-accept-grading-suggestion-rating-category-id="<%= @presenter.accept_grading_suggestion_rating_category.id %>"
  data-reject-grading-suggestion-rating-category-id="<%= @presenter.reject_grading_suggestion_rating_category.id %>"
  >
</div>
