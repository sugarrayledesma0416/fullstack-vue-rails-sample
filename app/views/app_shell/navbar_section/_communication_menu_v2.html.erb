<a 
  href="#"
  aria-controls="communication-subnav"
  class="c-menu__title  c-menu__title--program  js-nav-system__link
         <%= main_nav_active('communication') %>"
  aria-expanded="false"
  role="button">
    Communications
    <span aria-hidden="true">
      <%= Music::Components.icon(variant: 'caret', classes: ['c-menu__title--icon']) %>
    </span>
</a>

<ul
  class="c-menu__inner  c-menu__inner--program  c-menu__inner--right-align  js-nav-system__subnav" 
  id="communication-subnav">
  <li class="js-nav-system__subnav__item">
    <%= link_to main_app.section_announcements_path(section),
                class: 'c-menu__item  c-menu__item--program  js-nav-system__subnav__link' do %>
          <%= render(
                    'app_shell/menu_item',
                    item_icon: 'announcements',
                    item_name: 'Announcements',
                    item_description: 'Course announcements from your teacher.'
                ) %>
    <% end %>
  </li>

  <% unless supersite_junior? %>
    <li class="js-nav-system__subnav__item">
      <%= link_to main_app.forums_path(current_program, current_section),
                  class: 'c-menu__item  c-menu__item--program  js-nav-system__subnav__link' do %>
            <%= render(
                  'app_shell/menu_item',
                  item_icon: 'forums',
                  item_name: 'Forums',
                  item_description: 'Practice communication voice and text board.'
                ) %>
      <% end %>
    </li>
  <% end %>

  <% unless defined? DISABLE_HELP_REQUESTS %>
    <li class="js-nav-system__subnav__item">
      <%= link_to main_app.help_requests_index_path(section),
                  class: 'c-menu__item  c-menu__item--program  js-nav-system__subnav__link' do %>
            <%= render(
                  'app_shell/menu_item',
                  item_icon: 'student_requests',
                  item_name: 'Help Requests',
                  item_description: 'Your requests for help with assignments or grades.'
                ) %>
      <% end %>
    </li>
  <% end %>

  <li class="js-nav-system__subnav__item">
    <%= link_to main_app.section_notifications_path(section),
                class: 'c-menu__item  c-menu__item--program  js-nav-system__subnav__link' do %>
          <%= render(
                'app_shell/menu_item',
                item_icon: 'notifications',
                item_name: 'Notifications',
                item_description: 'System updates.'
              ) %>
    <% end %>
  </li>
</ul>
