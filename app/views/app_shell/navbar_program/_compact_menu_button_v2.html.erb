<button type="button"
        aria-label="Menu"
        aria-expanded="false"
        data-target="main-menubar"
        class="c-menu__title  c-no-button  c-no-button--compact-menu
               js-compact-menu-button">
  <span class="c-menu__title--menu-icon  js-compact-menu-icon">
    <%= inline_svg_tag("program_navigation/icons/menu-open.svg", class: "c-svg") %>
  </span>
  <span class="c-menu__title--close-icon  js-compact-close-icon  u-hidden">
    <%= inline_svg_tag("program_navigation/icons/menu-close.svg", class: "c-svg") %>
  </span>
</button>
