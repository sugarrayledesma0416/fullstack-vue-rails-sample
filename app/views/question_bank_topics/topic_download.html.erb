<%= link_to(question_bank_topics_path) do %>
  <%= Music::Components.icon(
        variant: 'return',
        text: 'Return to Question Bank Topics List',
        classes: ['c-embedded-icon--md', 'u-txt-16']
      ) %>
<% end %>

<div class="l-grid  u-mar-bot-16">
  <div class="l-col-12  u-pad-top-16">
    <h1 class="c-heading--page-title  u-txt-24">
      <%= @title %>
    </h1>
  </div>
</div>

<div class="ns-music-v1">
  <%= form_tag(topics_csv_question_bank_topics_path, method: :get) do %>
    <div class="c-form-item">
      <%= label_tag :language, "Language", { class: 'c-form-item__label' }  %>
      <%= select_tag :language, options_for_select(@languages), class: 'c-select  u-mar-bot-16' %>

      <%= label_tag :level, "Level", { class: 'c-form-item__label  u-pad-top-8' }  %>
      <%= select_tag :level, options_for_select(@levels), class: 'c-select  u-mar-bot-16' %>
    </div>
    <div class="c-form-item">
      <%= submit_tag 'Download Topics', class: 'c-button  c-button--primary  u-mar-top-16' %>
    </div>
  <% end %>
</div>
