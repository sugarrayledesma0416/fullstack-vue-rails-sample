<% content_for(:body_classes, "standard_layout") %>
<% if current_user.instructor? %>
  <% content_for(:focus, render(:partial => 'instructor/focus/show')) %>
  <% content_for(:navigation, render(:partial => 'app_shell/navbar_program/main')) %>
<% else -%>
  <%= hidden_field_tag :return_to, request.request_uri %>
<% end -%>

<% if current_user.student? && @section -%>
  <% content_for(:navigation, render(:partial => 'app_shell/navbar_section/main', :locals => {:section => @section} )) %>
<% end -%>
<div id="main_content">
  <div>
    <p>Your account does not have privileges to access this assignment.</p>

    <p>You must redeem a new code. You may purchase a code from <%= link_to "our store", "http://vistahigherlearning.com/students/store/" %>. Verify with your instructor that you need access before making a purchase.</p>

    <p>If you have a new code to redeem, you may <%= link_to "enter it now", "http://vistahigherlearning.com/students/store/" %>.</p>

    <p>If you redeemed a code, but are still unable to access the assignment, send an email to <%= mail_to "ts@vistahigherlearning.com", "technical support" %>.</p>

    <p>Include the following information in your email:</p>
        <ul>
          <li>Your name</li>
          <li>The code(s) you redeemed to access your instructor's course</li> 
          <li>Any email address(es) you might have used to set up an account</li>
          <li>Your VHL Central username(s)</li>
        </ul>


    <p>Thank you.</p>
  </div>
</div>
