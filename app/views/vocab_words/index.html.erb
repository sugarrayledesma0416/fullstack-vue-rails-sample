<% content_for(:js_head, javascript_include_tag("maestro_activity_engine/audio_item_player")) %>

<% content_for(:js_head, javascript_include_tag('angular-resource.js')) %>
<% content_for(:js_head, javascript_include_tag('vocab_words/vocab_words_app_bootstrap')) %>

<% content_for(:css_head, stylesheet_link_tag('vocab_words')) %>
<% content_for(:css_head, stylesheet_link_tag("maestro_activity_engine/recording")) %>

<% if current_user.instructor? %>
  <% content_for(:focus, render(:partial => 'instructor/focus/show')) %>
  <% content_for(:navigation, render(:partial => 'app_shell/navbar_program/main')) %>
<% else %>
  <% content_for(:navigation, render(:partial => 'app_shell/navbar_section/main', :locals => { :section => current_section } )) %>
<% end %>

<% content_for(:body_classes, "vocab_words standard_layout vhl-app:vocab_words_app") %>
<% content_for(:angular_tags, 'vhl-app="vocab_words_app" id="vhl-app" vt-close-drop-downs'.html_safe) %>

<%= render :partial => 'maestro_activity_engine/activities/partials/arc_player_handlerbars_templates' %>

<div id="main_content" data-program-id="<%= current_program.id %>">
  <div>
    <div ng-controller="VocabCtrl" ng-init="program_id=48">
      <div class="add-word-success-msg" vt-add-word-success-msg="add_word_success_enabled">Your word was added successfully. Note that it may be offscreen because it is not within your current search.</div>

      <div class="vocab-tools">
        <div class="search-bar">
          <input type="text" ng-model="search_term" class="search_box" name="search_term" search-input data-js-accent-input ng-paste="handle_paste()" />
        </div>
        <div class="lesson-select">
          Search in:

          <div>
            <select ng-model="searcher_selected_lesson" ng-show="has_multiple_programs()" ng-options="lesson.name group by lesson.program_name for lesson in lessons" class="lessons_filter">
              <option value="">All lessons</option>
            </select>

            <select ng-model="searcher_selected_lesson" ng-show="!has_multiple_programs()" ng-options="lesson.name for lesson in lessons" class="lessons_filter">
              <option value="">All lessons</option>
            </select>
          </div>

        </div>
        <div class="practice-modes">
          <div class="practice-mode" vt-drop-down-container>
            <a href="#" class="prevent-default print_pdf_modes">Practice Mode</a>
            <ul class="print_pdf_links" data-js-dropdown vt-drop-down-menu>
              <li><a href="#" ng-click="print_pdf('spanish_english')">{{program_language}} + English PDF</a></li>
              <li><a href="#" ng-click="print_pdf('spanish_definition')">{{program_language}} + Definition PDF</a></li>
              <li><a href="#" ng-click="print_pdf('spanish_english_definition')">{{program_language}} + English + Definition PDF</a></li>
              <li><a href="#" ng-click="print_pdf('spanish_blanks')">{{program_language}} Words with Blanks PDF</a></li>
              <li><a href="#" ng-click="print_pdf('english_blanks')">English Words with Blanks PDF</a></li>
              <li><a href="#" ng-click="print_pdf('definitions_blanks')">Definitions with Blanks PDF</a></li>
            </ul>
          </div>

          <div class="practice-mode" vt-drop-down-container>
            <a href="#" class="prevent-default practice_modes">Print PDF</a>
            <div class="practice_mode_links" data-js-dropdown vt-drop-down-menu>
              <a href="#" ng-click="start_practice(mode)"  ng-repeat="mode in practice_modes" ng-dialog="practice_dialog" ng-close="Done">{{mode.name}}</a>
            </div>
          </div>
        </div>
        <div class="column_sort_dropdown" vt-drop-down-container>
          <div class="sort_label">Sorted by</div>
          <div class="sort_type_indicator">
            {{ui_sort_name}}<div class="column_sort_arrow"></div>
          </div>
          <ul class="sort_menu" data-js-dropdown vt-drop-down-menu>
            <li ng-click="set_sort_predicate('created_at')">{{sort_name_mapping['created_at']}}</li>
            <li ng-click="set_sort_predicate('target_word')">{{sort_name_mapping['target_word']}}</li>
            <li ng-click="set_sort_predicate('target_definition')">{{sort_name_mapping['target_definition']}}</li>
            <li ng-click="set_sort_predicate('base_word')">{{sort_name_mapping['base_word']}}</li>
            <li ng-click="set_sort_predicate('lesson_name')">{{sort_name_mapping['lesson_name']}}</li>
          </ul>
        </div>
      </div>


      <div id="spinner" data-ng-spinner><img alt="Loading_32" src="/images/loading_32.gif"></div>

      <form ng-submit="add_vocab_word();" name="add_vocab_word_form" novalidate >
        <table id="vocab_words_table">
          <thead>
            <tr>
              <th class="drop_control program-header-bar"></th>
              <th class="column_language program-header-bar" ng-click="set_sort_predicate('target_word')" ng-class="{sorted: current_sort.target_word, sort_reverse: sort_reverse}">{{program_language}}</th>
              <th class="column_definition program-header-bar" ng-click="set_sort_predicate('target_definition')" ng-class="{sorted: current_sort.target_definition, sort_reverse: sort_reverse}">Definition</th>
              <th class="column_english program-header-bar" ng-click="set_sort_predicate('base_word')" ng-class="{sorted: current_sort.base_word, sort_reverse: sort_reverse}">English</th>
              <th class="column_lesson program-header-bar" ng-click="set_sort_predicate('lesson_name')" ng-class="{sorted: current_sort.lesson_name, sort_reverse: sort_reverse}">Lesson</th>
              <!-- <th class="column_image">Attach</th> -->
          </tr>
          </thead>
          <tbody toggleable vocabword="new_vocab_word" ng-class="{open_row: get_current_word(new_vocab_word) === true}">

            <tr class="drop_control new_word_row" ng-hide="get_current_word(new_vocab_word) === true">
              <td class="add_word" title="Click to begin adding word">
              </td>
              <td class="target_word">
                <input type="text" ng-model="new_vocab_word.target_word" name="new_word_target_word" placeholder="New Word..." class="new_word_placeholder" disabled="disabled" />
              </td>
              <td class="target_definition">
                <input type="text" ng-model="new_vocab_word.target_definition" name="new_word_target_definition" placeholder="Definition..." class="new_word_placeholder" disabled="disabled" />
              </td>
              <td class="base_word">
                <input type="text" ng-model="new_vocab_word.base_word" name="new_word_base_word" placeholder="English..." class="new_word_placeholder" disabled="disabled"/>
              </td>
              <td class='lesson_name'>
                <select disabled="disabled" ng-model="selected_lesson" ng-show="has_multiple_programs()" name="new_word_lesson" ng-options="lesson.name group by lesson.program_name for lesson in lessons" class="choose-lesson-add">
                  <option value="">Lesson...</option>
                </select>

                <select disabled="disabled" ng-model="selected_lesson" ng-show="!has_multiple_programs()" name="new_word_lesson" ng-options="lesson.name for lesson in lessons" class="choose-lesson-add">
                  <option value="">Lesson...</option>
                </select>
              </td>
            </tr>

            <tr class="new_word_row" ng-show="get_current_word(new_vocab_word) === true">
              <td class="drop_control add_word" title="Click to stop adding word">
              </td>
              <td class="target_word">
                <input type="text" ng-model="new_vocab_word.target_word" name="new_word_target_word" placeholder="New Word..." is-disabled data-js-accent-input word-attribute />
              </td>
              <td class="target_definition">
                <input type="text" ng-model="new_vocab_word.target_definition" name="new_word_target_definition" placeholder="Definition..." is-disabled data-js-accent-input word-attribute />
              </td>
              <td class="base_word">
                <input type="text" ng-model="new_vocab_word.base_word" name="new_word_base_word" placeholder="English..." is-disabled data-js-accent-input word-attribute />
              </td>
              <td class='lesson_name'>
                <select ng-model="selected_lesson" ng-show="has_multiple_programs()" name="new_word_lesson" ng-options="lesson.name group by lesson.program_name for lesson in lessons" class="choose-lesson-add">
                  <option value="">Lesson...</option>
                </select>

                <select ng-model="selected_lesson" ng-show="!has_multiple_programs()" name="new_word_lesson" ng-options="lesson.name for lesson in lessons" class="choose-lesson-add">
                  <option value="">Lesson...</option>
                </select>
              </td>
            </tr>
            <tr class="record_details" ng-show="get_current_word(new_vocab_word) === true">
              <td></td>
              <td></td>
              <td class='tag-list'>
                <div class="tag-label">Tags:</div>
                <ul>
                  <!-- Vocab Tags not currently working -->

                  <!--
                    <li ng-repeat="vocab_tag in new_vocab_word.vocab_tags" tag>
                      <span class="tag-text">{{vocab_tag.name}}</span>
                      <span class="rm-tag" remove-tag>x</span>
                    </li>
                    <li class="new-tag">
                      <input type="text" ng-model="new_vocab_tag.name" new-tag />
                    </li>
                  -->
                </ul>
              </td>
              <td></td>
              <td>
                <a href="#" class="white-button" ng-click="clear_new_word()">Cancel</a>
                <input type="submit" class="red-button add-word-button" value="Save" ng-class="{disabled: add_word_disabled}" ng-disabled="add_word_disabled" />
              </td>
            </tr>
          </tbody>
          <tbody ng-repeat="vocab_word in paged_items[current_page]" ng-class-odd="'odd'" ng-class-even="'even'" toggleable vocabword="vocab_word" ng-class="{open_row: get_current_word(vocab_word) === true}" vocabValidate>
            <tr class="vocab-record" ng-hide="get_current_word(vocab_word) === true">
              <td class="drop_control" title="Click to begin editing word">
              </td>
              <td>
                <div ng-bind="vocab_word.target_word" class="vocab_word_target_word"></div>
              </td>
              <td>
                <div ng-bind="vocab_word.target_definition" class="vocab_word_target_definition"></div>
              </td>
              <td>
                <div ng-bind="vocab_word.base_word" class="vocab_word_base_word"></div>
              </td>
              <td>
                <div ng-bind="vocab_word.lesson_name" class="vocab_word_lesson"></div>
              </td>
            <!--  <td class="user-image">
                <img ng-click="initialize_viewer(vocab_word)" ng-src="/{{vocab_word.public_filename}}" ng-hide="!vocab_word.public_filename" data-watching-modal='#modal-view' data-dialog-shown='viewer_dialog_shown' data-ng-disable="viewer_dialog_shown" />
              </td> -->
            </tr>

            <tr class="vocab-record-edit" ng-show="get_current_word(vocab_word) === true">
              <td class="drop_control" title="Click to finish editing word">
              </td>
              <td>
                <textarea ng-model="vocab_word.target_word" data-current-field="target_word" vt-accent-blur class="editable-content" save-on-blur data-js-accent-input></textarea>
              </td>
              <td>
                <textarea ng-model="vocab_word.target_definition" data-current-field="target_definition" vt-accent-blur class="editable-content" save-on-blur data-js-accent-input></textarea>
                </div>
              </td>
              <td>
                <textarea ng-model="vocab_word.base_word" data-current-field="base_word" vt-accent-blur class="editable-content" save-on-blur data-js-accent-input></textarea>
              </td>
              <td class="lesson">

                <select ng-model="lesson_at_edit" ng-init="lesson_at_edit=find_lesson(vocab_word.lesson_id)" ng-show="has_multiple_programs()" ng-options="lesson.name group by lesson.program_name for lesson in lessons" class="choose-lesson-add" save-on-blur>
                  <option value="">Lesson...</option>
                </select>

                <select ng-model="lesson_at_edit" ng-init="lesson_at_edit=find_lesson(vocab_word.lesson_id)" ng-show="!has_multiple_programs()" ng-options="lesson.name for lesson in lessons" class="choose-lesson-add" save-on-blur>
                  <option value="">Lesson...</option>
                </select>

              </td>
              <!--
               <td class="uploader">
                <a class="vocab-icon recorder" data-watching-modal='#modal-recording' data-dialog-shown='recording_dialog_shown' data-ng-disable="recording_dialog_shown" ng-class="{has_file: vocab_word.recording_path}">Recorder</a>

                <img ng-click="initialize_viewer(vocab_word)" ng-src="/{{vocab_word.public_filename}}" ng-hide="!vocab_word.public_filename" data-watching-modal='#modal-view' data-dialog-shown='viewer_dialog_shown' data-ng-disable="viewer_dialog_shown" />

                <a class="vocab-icon uploader" data-watching-modal='#modal-upload' data-dialog-shown='uploader_dialog_shown' ng-show="!vocab_word.public_filename" data-ng-disable="uploader_dialog_shown">Upload</a>
               </td>
              -->
            </tr>

            <tr class="record_details" ng-show="get_current_word(vocab_word) === true">
              <td></td>
              <td></td>
              <td class='tag-list'>
                <div class="tag-label">Tags:</div>
                <ul>
                  <li ng-repeat="vocab_tag in vocab_word.vocab_tags" tag>
                    <span class="tag-text">{{vocab_tag.name}}</span>
                    <span class="rm-tag" remove-tag>x</span>
                  </li>
                  <li class="new-tag">
                    <input type="text" ng-model="new_vocab_tag.name" new-tag />
                  </li>
                </ul>
              </td>
              <td></td>
              <td>
                <a href="#" class="white-button delete-word" ng-confirm="Do you really want to delete the entry for '{{vocab_word.target_word}}'"
                   ng-confirm-action="delete_vocab_word(vocab_word)"
                   ng-title="Confirm deletion"
                   ng-btn-confirm="Yes">Delete</a>

                <a class="drop_control red-button save">Ok</a>
              </td>
            </tr>
          </tbody>
        </table>
      </form>

      <ul class="pagination_menu">
        <li ng-class="{disabled: current_page == 0}">
          <a href ng-click="prev_page()"><span class="prev">&lt;</span>Previous</a>
        </li>
        <li ng-repeat="p in paged_items" ng-class="{active: $index == current_page}" ng-click="set_page($index)">
          <a href="javascript:void(0)">{{$index+1}}</a>
        </li>
        <li ng-class="{disabled: current_page == paged_items.length - 1}">
          <a href ng-click="next_page()">Next<span class="next">&gt;</span></a>
        </li>
      </ul>

      <div id="practice_dialog" class="hidden_helper card_container">
        <div ng-repeat="card in practice_cards" class="card borders" ng-class="{fourth: ($index + 1) % 4==0, third: ($index + 1) % 3==0}" ng-card="card" ngVocabCard>
          <div class="word">
            <div class="card_a_outer outer" overflow>
              <div class="card_a inner">{{card.shown_text_a}}</div>
            </div>
            <div class="card_b_outer outer" overflow>
              <div class="card_b inner">{{card.shown_text_b}}</div>
            </div>
          </div>
          <div ng-card="card" ngVocabCard></div>
        </div>

        <div id="additional_links">
          <button ng-click="practice_more(practice_mode.practice_set_limit)" class="red-button">Practice More</button>
          <button class="close-btn white-button" id="close-button-practice"></button>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="vocab_bottom_toolbar_wrap">
  <div id="vocab_bottom_toolbar">
    <%= render :partial => 'maestro_activity_engine/activities/accent_bar', :locals => {:language => current_program.language_code} %>
  </div>
</div>
