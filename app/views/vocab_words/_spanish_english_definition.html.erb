<h1>My Vocabulary study sheet</h1>
<table>
  <thead>
    <tr>
      <td class="col_1"><%=current_program.language_name %></td>
      <td class="col_2">English</td>
      <td class="col_3">Definition</td>
    </tr>
  </thead>
<% vocab_words.each do |vocab_word| %>
  <tr>
    <td class="col_1"><%= vocab_word.target_word %></td>
    <td class="col_2"><%= vocab_word.base_word %></td>
    <td class="col_3"><%= vocab_word.target_definition %></td>
  </tr>
<% end %>
</table>
