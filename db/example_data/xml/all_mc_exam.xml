        <reference type="exam">
          <header>Escoger</header>
          <body>Escucha el audio para escoger la opción correcta para completar cada oración.</body>
        </reference>
        
        <reference type="audio">
        <audio id="111825"/>
        </reference>
    
        <item>
          <prompt>Dos de los mejores platos del restaurante son __.</prompt>
          <choices>
            <distractor>los entremeses del día y el cerdo</distractor>
            <distractor>el salmón y el arroz con pollo</distractor>
            <answer>la carne y el arroz con pollo</answer>
        </choices>
        </item>
    
        <item>
          <prompt>La camarera __.</prompt>
          <choices>
            <distractor>los lleva a su mesa, les muestra el menú y les sirve el postre</distractor>
            <answer>les habla de los especiales del día, les recomienda unos platos y ellos deciden qué van a comer</answer>
            <distractor>les lleva unas bebidas, les recomienda unos platos y les sirve pan</distractor>
        </choices>
        </item>
    
        <item>
          <prompt>Roberto va a comer __ Rosa.</prompt>
          <choices>
            <answer>tantos platos como</answer>
            <distractor>más platos que</distractor>
            <distractor>menos platos que</distractor>
        </choices>
        </item>
      
