    <activity activity_type="multiple_choice" title="Superlativos" language="es">
      <dl></dl>
      
      <items>
    
        <style>
            <item_numbers>show</item_numbers>
        </style>
    
        <reference type="exam">
          <header>Superlativos</header>
          <body>Listen and select the statements that express the correct superlatives.</body>
        </reference>
  
        <reference type="audio">
          <audio id="111962"/>
        </reference>  
      
        <item>
          <prompt></prompt>
          <choices>
            <distractor>Tus pantalones no son los más grandes de la tienda.</distractor>
            <answer>Tus pantalones son los más grandes de la tienda.</answer>
          </choices>
        </item>
    
        <item>
          <prompt></prompt>
          <choices>
            <answer>La camisa blanca es la más bonita del centro comercial.</answer>
            <distractor>La camisa blanca no es tan bonita como otras camisas de la tienda.</distractor>
          </choices>
        </item>
    
        <item>
          <prompt></prompt>
          <choices>
            <distractor>Las rebajas del centro comercial son peores que las rebajas de la tienda.</distractor>
            <answer>En el centro comercial puedes encontrar las mejores rebajas.</answer>
          </choices>
        </item>
    
        <item>
          <prompt></prompt>
          <choices>
            <answer>El vestido azul es el más caro de la tienda.</answer>
            <distractor>El vestido azul es el más barato de la tienda.</distractor>
          </choices>
        </item>
    
        <item>
          <prompt></prompt>
          <choices>
            <answer>Sebastián es el mejor vendedor de la tienda.</answer>
            <distractor>Sebastián es el peor vendedor de la tienda.</distractor>
          </choices>
        </item>
    
      </items>
    </activity>
  
    <activity activity_type="multiple_choice" title="Elegir" language="es">
      <dl></dl>

      <items>
    
        <style>
            <item_numbers>show</item_numbers>
        </style>
    
        <reference type="exam">
          <header>Elegir</header>
          <body>Elige la mejor respuesta para cada pregunta según el video clip.</body>
        </reference>
  
        <reference type="video">
          <video id="120249"/>
        </reference>
    
        <item>
          <prompt>¿Quién pidió jamón?</prompt>
          <choices>
            <distractor>Miguel</distractor>
            <answer>Maru</answer>
          </choices>
        </item>
    
        <item>
          <prompt>Según Felipe, ¿cómo están los espárragos?</prompt>
          <choices>
            <answer>sabrosísimos</answer>
            <distractor>fríos</distractor>
          </choices>
        </item>
    
        <item>
          <prompt>¿Qué pasa cuando el camarero entra corriendo?</prompt>
          <choices>
            <distractor>choca con (<i>he collides with</i>) el dueño del restaurante</distractor>
            <answer>choca con Felipe</answer>
          </choices>
        </item>
    
        <item>
          <prompt>Según el camarero, ¿qué pasó?</prompt>
          <choices>
            <distractor>le ayudaron con los platos</distractor>
            <answer>le quitaron la comida</answer>
          </choices>
        </item>
    
        <item>
          <prompt>Según Juan Carlos, ¿qué hicieron Felipe y él?</prompt>
          <choices>
            <answer>les sirvieron la comida a sus amigos</answer>
            <distractor>reservaron una mesa para cuatro</distractor>
          </choices>
        </item>
    
        <item>
          <prompt>¿Qué van a hacer Felipe y Juan Carlos para compensar (<i>to make up for</i>) los daños?</prompt>
          <choices>
            <distractor>van a invitar a Maru y a Miguel a otro restaurante</distractor>
            <answer>van a pagar la comida y lavar los platos</answer>
          </choices>
        </item>
      
