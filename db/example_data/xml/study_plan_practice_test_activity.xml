<activity activity_type="multiple_choice" title="{title of multiple choice activity}" language="">

  <dl></dl>
  <items>

    <style>
        <item_numbers>show</item_numbers>
    </style>

<reference type="diagnostic">
  <header>Política</header>
  <body>Select the best word to complete each sentence.</body>
</reference>


    <item>
      <prompt>Se espera que el candidato reduzca los ____.</prompt>
      <choices concept="18">
      <answer>impuestos</answer>
        <distractor>terremotos</distractor>
        <distractor>acontecimientos</distractor>
      </choices>
    </item>

    <item>
      <prompt>El día de las ____ los ciudadanos salen a votar.</prompt>
      <choices concept="18">
        <distractor>inundaciones</distractor>
        <distractor>desigualdades</distractor>
        <answer>elecciones</answer>
      </choices>
    </item>

    <item>
      <prompt>En una democracia, votar debe ser un ____.</prompt>
      <choices concept="18">
        <distractor>crimen</distractor>
        <answer>deber</answer>
        <distractor>soldado</distractor>
      </choices>
    </item>

    <item>
      <prompt>Los noticieros emitieron el ____ del presidente sobre la paz.</prompt>
      <choices concept="18">
        <distractor>incendio</distractor>
        <distractor>racismo</distractor>
        <answer>discurso</answer>
      </choices>
    </item>

    <item>
      <prompt>Los ciudadanos deben luchar por sus ____.</prompt>
      <choices concept="18">
      <answer>derechos</answer>
        <distractor>noticias</distractor>
        <distractor>desastres</distractor>
      </choices>
    </item>



  </items>
</activity>



