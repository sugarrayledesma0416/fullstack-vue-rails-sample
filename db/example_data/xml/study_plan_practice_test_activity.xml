<activity activity_type="multiple_choice" title="{title of multiple choice activity}" language="">

  <dl></dl>
  <items>

    <style>
        <item_numbers>show</item_numbers>
    </style>

<reference type="diagnostic">
  <header>Seleccionar</header>
  <body>Select the correct verb form to complete each sentence.</body>
</reference>


    <item>
      <prompt>Si los ciudadanos ____ bien, el gobierno no se habría vuelto una dictadura.</prompt>
      <choices concept="18.1">
        <distractor>elegirían</distractor>
        <distractor>han elegido</distractor>
        <answer>hubieran elegido</answer>
      </choices>
    </item>

    <item>
      <prompt>Si Ana Sofía ____ el cambio climático, explicaría los desastres naturales. </prompt>
      <choices concept="18.1">
        <distractor>habría estudiado</distractor>
        <answer>estudiara</answer>
        <distractor>hubiera estudiado</distractor>
      </choices>
    </item>

    <item>
      <prompt>Si ustedes ____ descansar, vayan de vacaciones.</prompt>
      <choices concept="18.1">
        <distractor>hubieran querido</distractor>
        <answer>quieren</answer>
        <distractor>han querido</distractor>
      </choices>
    </item>

    <item>
      <prompt>Si Isabel y María ____ con Fernando, él las habría encontrado en el concierto.</prompt>
      <choices concept="18.1">
      <answer>hubieran chateado</answer>
        <distractor>chatearan</distractor>
        <distractor>habrían chateado</distractor>
      </choices>
    </item>

    <item>
      <prompt>Si los humanos ____ en su salud, ni fumarían ni consumirían alcohol.</prompt>
      <choices concept="18.1">
        <distractor>piensan</distractor>
        <distractor>han pensado</distractor>
        <answer>pensaran</answer>
      </choices>
    </item>



  </items>
</activity>


