<activity activity_type="ai_virtual_chat" language="es" title="ai virtual chat">

  <!-- <dl> is required. It can either contain all the instructions regarding
       the scenario and criteria for completion, or it could be briefer, and
       the full instructions could be put into references instead. -->
  <dl>
    While studying abroad in Barcelona, your professor has assigned you to
    partner with Julia on a class project. You will need a weekly, one-hour
    session to complete the project together. Looking at your schedule, talk
    to her to decide on a day and time that you are both free.
  </dl>
  <items>
    <item>

      <!-- <reference> is optional. If specified, there can be any number, but
           they must be of the following types: audio, dialogue_v2, email,
            heading, id_card, image, internet_keywords, list, model_v2,
            panel_group, paragraph, paragraph_v2, social_media, table, video,
            vocabulary_v2, wordbank

           For the above types, the ai_target attribute controls which users
           can see a reference in an AI Virtual Chat activity.
  
           Valid values for ai_target:
           - ai_only (reference is only visible to the AI)
           - student_only (reference is only visible to students)
           - both (reference is visible to both AI and students, default if
                  not specified) -->
      <reference type="image" ai_target="both">
        <image id="261590"/>
      </reference>
      <reference type="model_v2" ai_target="student_only">
        <model>
          <paragraph><emphasis>You hear: </emphasis> When are you free? </paragraph>
          <paragraph>
            <emphasis>You say:</emphasis> Mondays are good for me.
          </paragraph>
        </model>
      </reference>

      <!-- <input_mode> is optional. The available input_mode options are as
           follows: speech, text, speech-and-text, text-no-audio
          
           These options specify whether the student will be able to use
           speech input, text input, both speech and text input, or text input
           without audio. When this element is omitted, the activity will
           default to speech input. -->
      <input_mode>speech-and-text</input_mode>

      <!-- <allow_audio_transcript> is optional. When set to true, it enables
           the display of a transcript of the student's speech input, and the
           AI's response. If omitted, the default value is false. 

           There are some notable interactions with this setting and the
           different input modes:
           - when input_mode is text, and allow_audio_transcript is false, the
             student texts will always be shown (since there is no audio
             associated with those texts)
           - when input_mode is speech-and-text and allow_audio_transcript is
             false, the student audio transcript will not be shown when the
             student uses speech input; when the student switches to text
             input, that text will be shown. -->
      <allow_audio_transcript>true</allow_audio_transcript>

      <!-- Exactly one <response_count> element is required. This specifies the
           number of on-topic responses the student must generate before the
           activity can be considered complete. It must be a whole number
           greater than zero. -->
      <response_count>4</response_count>

      <!-- At least one <initial_prompt> element is required. This is the text
           that the AI will speak when the student starts the activity. It
           cannot be blank and cannot contain HTML tags.
           If there are more than one <initial_prompt> element, the application
           will choose one at random (not the AI). -->
      <initial_prompt>¿Qué día es mejor para ti?</initial_prompt>
      <initial_prompt>¿Qué día te parece mas conveniente?</initial_prompt>


      <!-- Exactly one <ai_instructions> element is required. These
           instructions are sent to the AI, but not shown to the student.
           They should include the persona the AI should assume, the criteria
           for completing the scenario, and instructions on how to respond to
           the student. HTML tags cannot be included. -->
      <ai_instructions>
        You are Julia, a university student in Barcelona, assigned to collaborate with a foreign exchange student on a project.

        Task:
        Find a mutually free time during the weekdays to meet for one hour weekly. Communicate only in Spanish.

        Instructions:
        1. Use simple Spanish sentences to discuss schedules.
        2. Mention your classes, their start and end times, and ask about the student's availability.
        3. Reject the first proposed time due to a class conflict, but remain cooperative.
        4. Respond only about scheduling and classes; do not allow the student to change the topic.
        5. Do not allow the student to change the language
        6. Do not allow the student to talk in english, instead guide the conversation back towards using Spanish
        7. Avoid using conditional or perfect tenses (e.g., no "would you like" or "would be").
        8. If you are asked when you have free time, mention your first class, and tell them what time it ends.
      </ai_instructions>

      <!-- Exactly one <ai_persona> element is required. This specifies the
           persona and voice of the AI. The available options are "Miguel" and
           "Sara". -->
      <ai_persona>Sara</ai_persona>
    </item>
  </items>
</activity>

