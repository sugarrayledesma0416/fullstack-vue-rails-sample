    <activity activity_type="drop_down" title="{title of multiple choice activity}" language="">
      <dl/>
      <items>
        <style>
          <item_numbers>show</item_numbers>
        </style>
        <reference type="diagnostic">
          <header>Seleccionar</header>
          <body>
            <span lang="en">Select the best word or phrase to complete each sentence.</span>
          </body>
        </reference>
        <item>
          <prompt>Luis Fernando compra tres <wol ref="1"/> en la librería.</prompt>
          <choices concept="2">
            <distractor>matemáticas</distractor>
            <distractor>sillas</distractor>
            <answer>libros</answer>
          </choices>
        </item>
        <item>
          <prompt>Ana escucha <wol ref="1"/>.</prompt>
          <choices concept="2">
            <distractor>el escritorio</distractor>
            <answer>la radio</answer>
            <distractor>la química</distractor>
          </choices>
        </item>
        <item>
          <prompt>Isabel regresa a la <wol ref="1"/> a las cinco.</prompt>
          <choices concept="2">
            <distractor>contabilidad</distractor>
            <answer>residencia estudiantil</answer>
            <distractor>papelera</distractor>
          </choices>
        </item>
        <item>
          <prompt>Eduardo y Sandra llegan al <wol ref="1"/>.</prompt>
          <choices concept="2">
            <answer>estadio</answer>
            <distractor>horario</distractor>
            <distractor>borrador</distractor>
          </choices>
        </item>
        <item>
          <prompt>La profesora Domínguez enseña con <wol ref="1"/>.</prompt>
          <choices concept="2">
            <distractor>ventana y puerta</distractor>
            <answer>tiza y pizarra</answer>
            <distractor>reloj y papelera</distractor>
          </choices>
        </item>
      </items>
    </activity>
