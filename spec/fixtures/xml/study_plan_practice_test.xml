    <activity activity_type="multiple_choice" title="{title of multiple choice activity}" language="">
      <dl/>
      <items>
        <style>
          <item_numbers>show</item_numbers>
        </style>
        <reference type="diagnostic">
          <header>Preguntas</header>
          <body>
            <span lang="en">Select the correct type of question for each statement.</span>
          </body>
        </reference>
        <item>
          <prompt>Catalina baila los sábados en la noche. (<i>intonation</i>)</prompt>
          <choices concept="2.2">
            <distractor>Catalina baila los sábados en la noche, ¿no?</distractor>
            <distractor>¿Baila Catalina los sábados en la noche?</distractor>
            <answer>¿Catalina baila los sábados en la noche?</answer>
          </choices>
        </item>
        <item>
          <prompt>Los estudiantes contestan las preguntas. (<i>tag</i>)</prompt>
          <choices concept="2.2">
            <distractor>¿Los estudiantes contestan las preguntas?</distractor>
            <answer>Los estudiantes contestan las preguntas, ¿no?</answer>
            <distractor>¿Contestan las preguntas los estudiantes?</distractor>
          </choices>
        </item>
        <item>
          <prompt>Juan Carlos y yo preparamos el horario. (<i>inversion</i>)</prompt>
          <choices concept="2.2">
            <answer>¿Preparamos el horario Juan Carlos y yo?</answer>
            <distractor>Juan Carlos y yo preparamos el horario, ¿verdad?</distractor>
            <distractor>¿Juan Carlos y yo preparamos el horario?</distractor>
          </choices>
        </item>
        <item>
          <prompt>Enrique llega a la universidad. (<i>tag</i>)</prompt>
          <choices concept="2.2">
            <answer>Enrique llega a la universidad, ¿verdad?</answer>
            <distractor>¿Enrique llega a la universidad?</distractor>
            <distractor>¿Llega Enrique a la universidad?</distractor>
          </choices>
        </item>
        <item>
          <prompt>Silvia y Patricia conversan sobre psicología. (<i>inversion</i>)</prompt>
          <choices concept="2.2">
            <distractor>¿Silvia y Patricia conversan sobre psicología?</distractor>
            <distractor>Silvia y Patricia conversan sobre psicología, ¿no?</distractor>
            <answer>¿Conversan Silvia y Patricia sobre psicología?</answer>
          </choices>
        </item>
      </items>
    </activity>
