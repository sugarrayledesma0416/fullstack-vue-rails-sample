<?xml version="1.0" encoding="UTF-8"?>
<activity activity_type="multi_type" title="MultiType with Tables" language="es">
  <dl/>
  <items>
    <style>
      <item_numbers>show</item_numbers>
    </style>
    <activity activity_type="table_activity" language="es" title="foo">
      <dl>valid dl</dl>
      <items>
        <style>
          <item_numbers>show</item_numbers>
        </style>
        <table_fill_in_the_blank>
          <table>
            <header_row>
              <data>a</data>
              <header>b</header>
              <header>c</header>
              <header>d</header>
            </header_row>
            <data_row>
              <header>a1</header>
              <data><wol ref="4" /></data>
              <data><wol ref="1" /></data>
              <data>a4</data>
            </data_row>
            <data_row>
              <header>b1</header>
              <data><wol ref="2" /></data>
              <data>b3</data>
              <data><wol ref="3" /></data>
            </data_row>
            <footer_row>
              <header>c1</header>
              <data>c2</data>
              <data>c3</data>
              <data>c4</data>
            </footer_row>
          </table>
          <answers ref="1">
            <answer>foo</answer>
          </answers>
          <answers ref="2">
            <answer>foo</answer>
          </answers>
          <answers ref="3">
            <answer>foo</answer>
          </answers>
          <answers ref="4">
            <answer>foo</answer>
          </answers>
        </table_fill_in_the_blank>
      </items>
