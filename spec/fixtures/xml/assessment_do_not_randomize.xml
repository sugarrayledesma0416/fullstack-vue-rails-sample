            <answer>answer_1_1</answer>
            <distractor>answer_1_2</distractor>
          </choices>
        </item>
        <item>
          <prompt>Drop down question 2<wol ref="1"/> and <wol ref="2"/></prompt>
          <choices ref="1">
            <answer>answer_2_1_1</answer>
            <distractor>answer_2_1_2</distractor>
          </choices>
          <choices ref="2">
            <distractor>answer_2_2_1</distractor>
            <answer>answer_2_2_2</answer>
          </choices>
        </item>
        <item>
          <prompt>Drop down question 3<wol/></prompt>
