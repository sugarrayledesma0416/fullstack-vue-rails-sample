          <header><b>FIB activity header</b></header>
          <body>FIB activity body.</body>
        </reference>
        <style>
          <wol_size>words_small</wol_size>
          <item_numbers>show</item_numbers>
        </style>
        <item>
          <prompt>Test <wol ref="1"/> with <wol ref="2"/> blanks</prompt>
          <answers ref="1">
            <answer>Question 1 answer 1</answer>
          </answers>
          <answers ref="2">
            <answer>Question 1 answer 2</answer>
          </answers>
        </item>
        <item>
          <prompt><wol/></prompt>
          <answers>
            <answer>Question 2 answer</answer>
          </answers>
        </item>
        <item>
          <prompt>How <wol/> you?</prompt>
          <answers>
            <answer>Question 3 answer</answer>
          </answers>
        </item>
