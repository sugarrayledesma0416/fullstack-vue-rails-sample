      <title><b>Multiple choice activity title</b></title>
      <dl>Multiple choice activity direction line</dl>
      <items>
        <style>
          <item_numbers>show</item_numbers>
        </style>
        <reference type="exam">
          <header><b>Multiple choice activity header</b></header>
          <body>Multiple choice activity body.</body>
        </reference>
        <item>
          <prompt>multiple choice question 1</prompt>
          <choices>
            <answer>right answer 1</answer>
            <distractor>wrong answer 2</distractor>
            <distractor>wrong answer 3</distractor>
          </choices>
        </item>
        <item>
          <prompt>multiple choice question 2</prompt>
          <choices>
            <distractor>wrong answer 1</distractor>
            <answer>right answer 2</answer>
            <distractor>wrong answer 3</distractor>
          </choices>
        </item>
        <item>
          <prompt>multiple choice question 3</prompt>
          <choices>
            <distractor>wrong answer 1</distractor>
            <distractor>wrong answer 2</distractor>
            <answer>right answer 3</answer>
          </choices>
        </item>
