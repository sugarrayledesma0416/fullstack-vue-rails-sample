    <item>

      <!-- <input_mode> is optional. The available input_mode options are as
           follows: speech, text, speech-and-text, text-no-audio

           These options specify whether the student will be able to use
           speech input, text input, both speech and text input, or text input
           without audio. When this element is omitted, the activity will
           default to speech input. -->
      <input_mode>speech-and-text</input_mode>

      <!-- <allow_audio_transcript> is optional. When set to true, it enables
           the display of a transcript of the student's speech input, and the
           AI's response. If omitted, the default value is false.

           There are some notable interactions with this setting and the
           different input modes:
           - when input_mode is text, and allow_audio_transcript is false, the
             student texts will always be shown (since there is no audio
             associated with those texts)
           - when input_mode is speech-and-text and allow_audio_transcript is
             false, the student audio transcript will not be shown when the
             student uses speech input; when the student switches to text
             input, that text will be shown. 
          - when input_mode is text-no-audio, the student audio transcript will
             be always set to true no matter what the XML says (since there is
             no audio and only text input is allowed) -->
      <allow_audio_transcript>true</allow_audio_transcript>

      <!-- Exactly one <response_count> element is required. This specifies the
           number of on-topic responses the student must generate before the
           activity can be considered complete. It must be a whole number
           greater than zero. -->
      <response_count>4</response_count>

      <!-- Exactly one <initial_prompt> element is required. This is the text
           that the AI will speak when the student starts the activity. It
           cannot be blank and cannot contain HTML tags. -->
      <initial_prompt>¿Qué tal? ¿Cómo estás?</initial_prompt>

      <!-- Exactly one <ai_instructions> element is required. These
           instructions are sent to the AI, but not shown to the student.
           They should include the persona the AI should assume, the criteria
           for completing the scenario, and instructions on how to respond to
           the student. HTML tags cannot be included. -->
      <ai_instructions>
        You are a helpful AI assistant used to learn Spanish. Use the provided references to help answer questions accurately.
      </ai_instructions>

      <!-- Exactly one <ai_persona> element is required. This specifies the
        persona and voice of the AI. The available options are "Miguel" and
        "Sara". -->
      <ai_persona>Sara</ai_persona>
    </item>
