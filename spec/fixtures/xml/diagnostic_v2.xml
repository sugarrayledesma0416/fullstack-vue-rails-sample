    <activity activity_type="multiple_choice" title="">
      <dl/>
      <items>
        <style>
          <item_numbers>show</item_numbers>
        </style>
        <reference type="diagnostic">
          <header>Saludar</header>
          <body>
            <span lang="en">Select the correct answer to each question.</span>
          </body>
        </reference>
        <item>
          <prompt>¿Cómo se llama usted?</prompt>
          <choices concept="1">
            <distractor>Hasta la vista.</distractor>
            <answer>Me llamo Ana María.</answer>
          </choices>
        </item>
        <item>
          <prompt>¿Cómo estás, Juan José?</prompt>
          <choices concept="1">
            <answer>No muy bien.</answer>
            <distractor>No hay de qué.</distractor>
          </choices>
        </item>
        <item>
          <prompt>¿De dónde eres, Gabriel?</prompt>
          <choices concept="1">
            <distractor>De nada.</distractor>
            <answer>Soy de Quito, Ecuador.</answer>
          </choices>
        </item>
        <item>
          <prompt>¿Qué tal, Sandra?</prompt>
          <choices concept="1">
            <distractor>Lo siento</distractor>
            <answer>Bien, gracias.</answer>
          </choices>
        </item>
        <item>
          <prompt>¿Qué hay de nuevo, Carlos?</prompt>
          <choices concept="1">
            <distractor>Por favor.</distractor>
            <answer>Nada.</answer>
          </choices>
        </item>
      </items>
    </activity>
