        <item>
          <prompt>¿Qué sala es notable por sus muebles elegantes y sus lámparas de cristal?</prompt>
          <choices>
            <answer>el comedor Los Tamarindos</answer>
            <distractor>el salón Dr. Belisario Porras</distractor>
          </choices>
        </item>
        <item>
          <prompt>¿En qué parte del palacio se encuentra la residencia del presidente?</prompt>
          <choices>
            <distractor>en la planta baja</distractor>
            <answer>en el segundo piso</answer>
          </choices>
        </item>
        <item>
          <prompt>¿Dónde empiezan los turistas su visita al palacio?</prompt>
          <choices>
            <distractor>en el salón amarillo</distractor>
            <answer>en el Patio de las Garzas</answer>
          </choices>
        </item>
        <item>
          <prompt>¿En qué lugar se representa artísticamente la rica herencia cultural de Panamá?</prompt>
          <choices>
            <answer>en el Patio Andaluz</answer>
            <distractor>en el Patio de las Garzas</distractor>
          </choices>
        </item>
        <item>
          <prompt>¿Qué salón honra la memoria de un gran panameño?</prompt>
          <choices>
            <answer>el Salón Dr. Belisario Porras</answer>
            <distractor>el Salón Amarillo</distractor>
          </choices>
