-----END RSA PRIVATE KEY-----" > config/files_key.pem

# App can't be booted if the log directory doesn't exist.
mkdir -p log
echo 'TEMP: Running zeitwerk'
bundle exec rake zeitwerk:check --verbose

echo 'Precompile assets'
RAILS_GROUPS=assets time bundle exec rake assets:precompile

time bundle exec rails yarn:install

time bundle exec rails webpacker:compile

# We don't want the log directory to make it into our package.
rm -r log

# We don't need node_modules and they take up a lot of space.
rm -fr node_modules
