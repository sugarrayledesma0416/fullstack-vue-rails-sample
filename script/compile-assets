#!/bin/sh

set -e

echo 'CREATE DATABASE m3;' | mysql -uroot
echo "$RAILS_ENV:
  adapter: mysql2
  encoding: utf8
  reconnect: false
  database: m3
  pool: 5
  username: root
  password:
  host: localhost

gradebook_$RAILS_ENV:
  adapter: postgresql
  encoding: utf8
  database: gradebook
  pool: 1
  username: root
  password:
  host: localhost" > config/database.yml

# App can't be booted without UA_URL defined.
echo "UA_URL = 'http://localhost'" > config/initializers/local_config.rb

# App can't be booted if config/files_key.pem doesn't have an RSA key
# in it.  This is a dummy key.
echo "-----BEGIN RSA PRIVATE KEY-----
